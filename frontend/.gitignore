# ============================================================
# Frontend — React + Vite .gitignore
# ============================================================

# ── Build Outputs ────────────────────────────────────────────
dist/
dist-ssr/
build/
out/

# ── Dependencies ─────────────────────────────────────────────
node_modules/
.pnp
.pnp.js
.yarn/install-state.gz

# ── Environment ──────────────────────────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# ── Vite ─────────────────────────────────────────────────────
.vite/
vite.config.ts.timestamp-*
vite.config.js.timestamp-*

# ── Testing & Coverage ───────────────────────────────────────
coverage/
.nyc_output/
test-results/
playwright-report/
playwright/.cache/

# ── Logs ─────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Cache ────────────────────────────────────────────────────
.cache/
.eslintcache
.stylelintcache
*.tsbuildinfo

# ── Editor & IDE ─────────────────────────────────────────────
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*~

# ── OS ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
